# Entorno de pruebas.
#
# Laravel carga este archivo EN LUGAR de .env cuando APP_ENV=testing, así que
# aquí se aísla la suite por completo del .env de desarrollo.
#
# Motivo (incidente real): sin este archivo, el .env se cargaba después de que
# PHPUnit aplicara su configuración (phpunit.xml usa force="true"), y
# `composer test` terminaba ejecutando `migrate:fresh` sobre MySQL. Eso vació la
# base de desarrollo completa: 60 preguntas, candidatos, sesiones y resultados.
# La suite debe correr SIEMPRE contra SQLite en memoria.
APP_NAME="Test Raven (testing)"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

# Base de datos de pruebas: SQLite en memoria. No toca ningún archivo ni servidor.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

# Drivers en memoria/seguros para que una prueba nunca escriba fuera del proceso.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

LOG_CHANNEL=stderr
LOG_LEVEL=debug

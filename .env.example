# Plantilla de configuración de entorno.
#
# Copiar a .env y ajustar los valores:
#   cp .env.example .env && php artisan key:generate
#
# Esta plantilla NO es la configuración de producción: son los requisitos que la
# aplicación espera. En un entorno contenerizado (por ejemplo Docker Compose con
# la UTI), las variables se inyectan desde el orquestador y este archivo sirve de
# inventario de lo que hay que definir.

APP_NAME="Test de Raven - UES"
# En staging/producción: production (nunca local)
APP_ENV=local
# En staging/producción: false. Con true, cualquier error expone el entorno.
APP_DEBUG=true
# URL pública del sitio, sin barra final. Se usa para enlaces y assets.
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Generar con: php artisan key:generate
APP_KEY=

# driver | log | database | file
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En staging/producción: warning o error (debug genera mucho ruido)
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test_raven
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sesiones, caché y colas
# ---------------------------------------------------------------------------
# Los candidatos se autentican con sesión: cambiar default por drivers no
# persistentes afecta el flujo del test y los límites de intentos.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Recomendado true en producción: cifra el contenido de la cookie de sesión.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# El contador de los límites de intentos (registro y login) vive en la caché:
# con un store por proceso (array) el límite NO se comparte entre workers.
CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# Disco de archivos. Las láminas del test se sirven desde storage/app/public a
# través del enlace public/storage, que se crea con:
#   php artisan storage:link
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Correo
# ---------------------------------------------------------------------------
# En staging/producción: smtp (con log, los correos solo quedan en el log).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-responder@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Retención de datos (RNF-09.04 / RNF-09.05)
# ---------------------------------------------------------------------------
# Plazos en días por categoría y acción al vencer: 'disociar' (elimina los
# identificadores y conserva el dato desagregado) o 'suprimir' (elimina el dato).
# Los valores por defecto son una propuesta; la institución debe validarlos.
RETENCION_ACTIVA=true
RETENCION_PERSONAL_DIAS=365
RETENCION_PERSONAL_ACCION=disociar
RETENCION_PSICOMETRICO_DIAS=365
RETENCION_PSICOMETRICO_ACCION=disociar
RETENCION_ACTIVIDAD_DIAS=365
RETENCION_ACTIVIDAD_ACCION=suprimir
RETENCION_TECNICO_DIAS=180
RETENCION_TECNICO_ACCION=suprimir

# ---------------------------------------------------------------------------
# Redis (opcional; solo si se cambian SESSION/CACHE/QUEUE a redis)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# AWS S3 (opcional; no se usa actualmente)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

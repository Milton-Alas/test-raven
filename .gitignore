# IDX workspace configuration
.idx/

# Archivos y directorios de dependencias
/node_modules
/vendor

# Archivos de entorno
.env
.env.backup

# Archivos de base de datos local
/database/database.sqlite
/database/*.sqlite

# Archivos de almacenamiento de Laravel
#/storage/app/public/*
!/storage/app/public/test-images/
!/storage/app/public/.gitignore
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/testing/
/storage/framework/views/
/storage/logs/

# Enlace simbólico de storage: lo crea "php artisan storage:link".
# No se versiona porque apunta a una ruta absoluta de la máquina de desarrollo y
# quedaría roto en cualquier otro entorno (staging, producción, un clon limpio).
/public/storage

# Archivos de compilación de assets
/public/build/
/public/hot

# Herramientas locales de desarrollo (binario PHP estático)
/.tools/

# Caché local de npm (este entorno tiene HOME de solo lectura)
/.npm-cache/
/.npm/

# Respaldos locales (contienen la clave de cifrado y volcados de la base)
/storage/backups/

# Otros
.phpunit.result.cache
Homestead.json
Homestead.yaml

# Logs de paquetes
npm-debug.log
yarn-error.log
yarn-debug.log
